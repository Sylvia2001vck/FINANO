# 低配 VPS：在内存充足的机器上先构建好前端，再把 dist 放进本目录后构建（不在服务器上跑 vite）
#   cd frontend && npm ci && npm run build
#   docker build -f Dockerfile.prebuilt -t finano-frontend:latest .
FROM nginx:alpine
COPY dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
